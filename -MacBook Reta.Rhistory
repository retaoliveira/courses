library(tidyverse)
library(knitr)
library(kableExtra)
estrutura_q1 <- data.frame( Produto = c("A", "A", "B"), Componente = c("B", "C", "C"), Quantidade = c(2, 3, 3) )
kable(estrutura_q1, caption = "Estrutura de Montagem do Produto A") %>% kable_styling(bootstrap_options = c("striped", "hover", "condensed"), full_width = FALSE)
estrutura_q2 <- data.frame( Item = c("A", "A", "B", "B", "C", "C"), Componente = c("B", "C", "C", "D", "E", "F"), Quantidade = c(2, 2, 4, 1, 1, 1) )
kable(estrutura_q2, caption = "Estrutura de Montagem do Produto A") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"), full_width = FALSE)
